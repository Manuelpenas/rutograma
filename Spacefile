# Configuration for Deta Space
# https://deta.space/docs/en/build/reference/spacefile

v: 0
app_name: rutograma

micros:
  - name: backend
    src: .
    engine: nodejs16
    primary: true
    serve: server.js
    dev: node server.js
    env:
      - name: JWT_SECRET
        value: "rutograma-secret-2024"
      - name: NODE_ENV
        value: "production"
    run:
      - npm install
