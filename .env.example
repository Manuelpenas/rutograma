# ===================================================
# RUTOGRAMA - Variables de Entorno
# Copia este archivo como .env y completa los valores
# ===================================================

# Puerto del servidor (default: 3000)
PORT=3000

# Clave secreta para JWT (cambia esto por una cadena aleatoria larga)
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_de_al_menos_64_caracteres

# Expiración del token JWT
JWT_EXPIRES_IN=24h

# Nombre del sistema
APP_NAME=Rutograma

# URL base del sistema (sin barra final)
APP_URL=http://localhost:3000

# ---- APIS EXTERNAS (GRATUITAS) ----

# OpenWeatherMap - Regístrate GRATIS en https://openweathermap.org/api
# Plan Free: 1000 llamadas/día
OPENWEATHER_API_KEY=tu_api_key_de_openweathermap

# ---- SAAS ADMIN ----
# Email del super administrador inicial
SUPER_ADMIN_EMAIL=admin@rutograma.com
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=Super Administrador

# ---- BASE DE DATOS ----
DB_PATH=./database/rutograma.db

# ---- ENTORNO ----
NODE_ENV=production
